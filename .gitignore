# Dependencies
node_modules/

# Regenerable IEG artifacts — recreate rather than commit
# (see MAINTENANCE-HANDOFF.md §12 "Regenerable artifacts")
.pnpm-store/
.ieg-verify/

# Throwaway DSH home used by the evaluation overlays. It holds profiles and
# session history, and must never be committed.
.ieg-e2e/dsh-home/

# Evaluation sandboxes and derived results. The method lives in eval/README.md;
# a recorded sandbox is transient by design, and a stale copy reads as standing
# evidence.
eval/runs/
eval/e2e-results.json
eval/e2e-analysis.json

# Credentials and session data — never commit these, anywhere.
# P0-1 widened this list: it previously covered only `.credentials.yaml` and `.dsh/`, so a
# `git add -A` could have committed a `.env`, a private key or an auth file by accident.
.credentials.yaml
*.credentials.yaml
.credentials
.credentials.*
.dsh/
sessions/
storages/
.env
.env.*
*.env
.netrc
auth.json
credentials.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*

# Release tarballs are regenerable build output (`npm pack`) and are attached to
# a GitHub release; never commit one.
*.tgz
*.tgz.sha256

# Logs and local scratch
*.log
dump.err
bad.err
good.err

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Scratch trees used by one-off verification runs. Swept up by `git add -A`
# once; never commit them.
.packtest/
.packtest-cache/
.ieg-item1/
.ieg-verify*/
.npm-verify/
.tsprobe/
.migration-probe/
.pnpm-cache/
